# Copy to .env (never commit .env)
BASEROW_URL=http://127.0.0.1:8000
# Database token: Baserow > Settings > Database tokens. Give it read on all
# tables and update on Requirement only. Used instead of your login.
BASEROW_TOKEN=
# Fallback only if no token is set:
BASEROW_EMAIL=
BASEROW_PASSWORD=
TABLE_STAKEHOLDER_NEED=709
TABLE_REQUIREMENT=703
TABLE_SYSTEM_ELEMENT=701
TABLE_ALLOCATION=706
TABLE_VERIFICATION=707
SDOC_OUT_DIR=docs/sdoc
